---
services:
  mariadb:
    image: {{ mariadb_image }}
    container_name: mariadb
    restart: unless-stopped
    environment:
      MARIADB_ROOT_PASSWORD: "{{ mariadb_root_password }}"
    ports:
      - "{{ mariadb_port }}:3306"
    volumes:
      - {{ mariadb_data_dir }}:/var/lib/mysql
    healthcheck:
      test: ["CMD", "healthcheck.sh", "--connect", "--innodb_initialized"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 60s
