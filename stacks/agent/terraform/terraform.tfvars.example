# ============================================================
# BOOTSTRAP — this stack runs locally once.
# Copy to terraform.tfvars and fill in the values.
# terraform.tfvars is gitignored.
# ============================================================

proxmox_api_url      = "https://192.168.1.X:8006/api2/json"
proxmox_api_token_id = "terraform@pve!terraform"
proxmox_tls_insecure = true
proxmox_node         = "pve04"

lxc_template = "local:vztmpl/ubuntu-22.04-standard_22.04-1_amd64.tar.zst"

agent_ip = "192.168.1.50"
gateway  = "192.168.1.1"
storage  = "local-lvm"

# ============================================================
# SENSITIVE VARIABLES — only for this bootstrap stack,
# they go here in terraform.tfvars (gitignored).
# ============================================================
proxmox_api_token_secret = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
lxc_root_password        = "changeme"
ssh_public_key           = "ssh-ed25519 AAAA... your-key"
