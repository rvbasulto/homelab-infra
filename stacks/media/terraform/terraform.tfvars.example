# ============================================================
# NON-SENSITIVE VALUES — safe to commit
# ============================================================
# Copy to terraform.tfvars (gitignored) for local development.
# In CI / Terraform Cloud, define ALL variables directly
# in the workspace (no terraform.tfvars needed).

proxmox_api_url      = "https://pve04.home.lab:8006/api2/json"
proxmox_api_token_id = "terraform@pve!terraform"
proxmox_tls_insecure = true
proxmox_node         = "pve04"

lxc_template = "local:vztmpl/ubuntu-22.04-standard_22.04-1_amd64.tar.zst"

nextcloud_ip = "192.168.1.65"
gateway      = "192.168.1.1"
storage      = "local-lvm"

# Verify real path with: pvesm status (on pve04)
# Before first apply: chown -R 100000:100000 /mnt/pve/disk2t
disk2t_host_path      = "/mnt/pve/disk2t"
disk2t_container_path = "/mnt/disk2t"

# ============================================================
# SENSITIVE VARIABLES — define in Terraform Cloud workspace
# (Settings → Variables → + Add variable → mark "Sensitive")
# ============================================================
# proxmox_api_token_secret  → Proxmox API token secret
# lxc_root_password         → LXC root password
# ssh_public_key            → SSH public key
