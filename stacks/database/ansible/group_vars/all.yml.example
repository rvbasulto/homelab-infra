# SOPS workflow:
#   1. cp all.yml.example all.yml
#   2. Fill in real values
#   3. sops --encrypt --in-place all.yml   # encrypts the file in-place
#   4. git add all.yml                     # safe: encrypted with age
#
# To edit later: sops all.yml  (opens in $EDITOR, saves encrypted)
# Age key loaded from: $SOPS_AGE_KEY_FILE (default: ~/.config/sops/age/keys.txt)

# MariaDB role variables
mariadb_root_password: "changeme"
mariadb_data_dir: "/opt/mariadb/data"
mariadb_port: 3306
